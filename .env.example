PORT=8000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/<database_name>?retryWrites=true&w=majority
CORS_ORIGIN=* 
ACCESS_TOKEN_SECRET=32_byte_random_hex_string_for_access_token_security
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=32_byte_random_hex_string_for_refresh_token_security
REFRESH_TOKEN_EXPIRY=10d
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
GEMINI_API_KEY=your_gemini_api_key
